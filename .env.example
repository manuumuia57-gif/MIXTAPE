# GEMINI_API_KEY: Optional server-side key for live AI Study Assistant responses via @google/genai.
# AI Studio automatically injects this at runtime when configured in Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: HMAC signing key for server-side session tokens (optional in local demo).
AUTH_SECRET="focuscampus-dev-session-secret"

# Optional PostgreSQL / Supabase connection (for external production deployment; see db/schema.sql).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
PGHOST=""
PGDATABASE=""
PGUSER=""
PGPASSWORD=""
