# GEMINI_API_KEY: Optional server-side key for AI-assisted practice question generation & categorization via @google/genai.
# AI Studio automatically injects this at runtime when configured in Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: HMAC signing key for server-side session tokens.
AUTH_SECRET="campus-exam-vault-dev-secret-2026"

# MAX_UPLOAD_SIZE_MB: Maximum permitted academic document upload size in megabytes.
MAX_UPLOAD_SIZE_MB="25"

# Optional PostgreSQL / Supabase connection (for external production deployment; see db/schema.sql).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
PGHOST=""
PGDATABASE=""
PGUSER=""
PGPASSWORD=""
